<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smartpantry"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />
    <!-- Offline pantry app: deliberately no INTERNET, location, map or storage permissions. -->
    <application
        android:name="com.example.smartpantry.PantryApp"
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_pantry"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.example.smartpantry.SettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantry.RecipeDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantry.RecipesActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantry.SuggestedRecipesActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantry.EditIngredientActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantry.PantryActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>