<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
<include layout="@layout/header"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp">
<TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ingredient name" android:labelFor="@id/ingredient_name"/>
<EditText android:id="@+id/ingredient_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:hint="e.g. tomatoes" android:maxLength="60" android:minHeight="48dp"/>
<TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quantity" android:labelFor="@id/quantity"/>
<EditText android:id="@+id/quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:hint="e.g. 0.5" android:maxLength="20" android:minHeight="48dp"/>
<TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Unit" android:labelFor="@id/unit"/>
<Spinner android:id="@+id/unit" android:layout_width="match_parent" android:layout_height="52dp"/>
<TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expiry date (optional)" android:labelFor="@id/expiry"/>
<EditText android:id="@+id/expiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:hint="YYYY-MM-DD" android:maxLength="10" android:minHeight="48dp"/>
<TextView style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Different lots can have separate expiry dates. Expired lots never count toward recipe matches." android:layout_marginTop="8dp"/>
<Button android:id="@+id/save" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="Save ingredient" android:layout_marginTop="24dp"/>
<Button android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="52dp" android:text="Delete ingredient" android:textColor="#A23333"/>
</LinearLayout></LinearLayout></ScrollView><include layout="@layout/navigation"/>
</LinearLayout>
